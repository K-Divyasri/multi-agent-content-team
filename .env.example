# Copy this file to ".env" (no .example) and fill in ONE key. The .env file is
# git-ignored, so your secret never gets committed.
#
# You only need a key for the --real flag (CLI) or the "use a real model" toggle
# (web app). The whole project runs offline without any key.

# FREE and recommended to start: Google Gemini.
# Get a key in 30 seconds at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pick the model with CONTENT_TEAM_MODEL (LiteLLM routes by the provider prefix):
#   gemini/gemini-1.5-flash        <- free tier, the default
#   groq/llama-3.1-8b-instant      <- free, very fast (needs GROQ_API_KEY)
#   claude-haiku-4-5               <- cheap & high quality (needs ANTHROPIC_API_KEY)
CONTENT_TEAM_MODEL=gemini/gemini-1.5-flash

# Other providers (only if you use them):
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
